# Copier ce fichier vers .env et adapter les valeurs
# Ne jamais committer le fichier .env

PORT=4000

# MySQL (XAMPP / MySQL Workbench / service Windows)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacie_mali

# true si MySQL cloud (Aiven, etc.)
DB_SSL=false

# Secret JWT — OBLIGATOIRE en production (≥ 24 caractères, aléatoire)
# Exemple local uniquement — change immédiatement :
JWT_SECRET=change-moi-pharmacie-mali-secret-long
JWT_EXPIRES_IN=8h

# Origins CORS autorisées (CSV). En prod Render same-origin : laisse vide
# ou mets https://ton-app.onrender.com si API séparée
# CORS_ORIGINS=http://localhost:5173,https://sandia-pharmacie-7c04.onrender.com

# Compte administrateur initial (utilisé par npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrateur
ADMIN_EMAIL=ton.email@exemple.com

# E-mail production (Render free bloque SMTP) : Brevo API HTTPS
BREVO_API_KEY=
BREVO_SENDER_EMAIL=ton.email@gmail.com
SMTP_FROM=SAN-DIA DISTRIBUTION <ton.email@gmail.com>

# E-mail local uniquement (Gmail SMTP — souvent bloqué sur Render free)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton.email@gmail.com
# SMTP_PASS=mot-de-passe-application

# true = code OTP aussi dans la réponse API si e-mail absent
# IGNORÉ si NODE_ENV=production (jamais de code en clair en prod)
AUTH_ALLOW_DEV_CODE=true

# Alertes péremption / stock / dettes → e-mail aux admins
ALERTES_EMAIL_ENABLED=true
ALERTES_INTERVAL_HEURES=6
# Secret pour cron externe (Render free s’endort) :
# POST /api/stats/alertes/cron  Header: x-cron-secret: <valeur>
CRON_SECRET=change-moi-cron-secret-long
