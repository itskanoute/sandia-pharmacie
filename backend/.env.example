# Copier ce fichier vers .env et adapter les valeurs
# Ne jamais committer le fichier .env

PORT=4000

# MySQL (XAMPP / MySQL Workbench / service Windows)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacie_mali

# Secret JWT — change cette valeur en production
JWT_SECRET=change-moi-pharmacie-mali-secret
JWT_EXPIRES_IN=8h

# Compte administrateur initial (utilisé par npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrateur
ADMIN_EMAIL=ton.email@exemple.com

# E-mail (codes de connexion). Exemple Gmail : activer « mot de passe d’application »
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ton.email@gmail.com
SMTP_PASS=mot-de-passe-application
SMTP_FROM=SAN-DIA DISTRIBUTION <ton.email@gmail.com>

# true = si SMTP absent, le code s’affiche aussi dans la réponse API (dev uniquement)
AUTH_ALLOW_DEV_CODE=true
